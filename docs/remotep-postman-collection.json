{
  "info": {
    "_postman_id": "8bfa2a52-7431-4a8f-bd15-remotep-diploma",
    "name": "RemoteP Diploma API",
    "description": "Postman collection for testing RemoteP Spring Boot API: auth, contacts, admin CRM, PostgreSQL content.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "userEmail",
      "value": "student@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@remotep.local"
    },
    {
      "key": "adminPassword",
      "value": "SET_ADMIN_PASSWORD_IN_POSTMAN"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "02 Content - Services RU",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/content/services?lang=ru"
      }
    },
    {
      "name": "03 Content - Portfolio KZ",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/content/portfolio?lang=kz"
      }
    },
    {
      "name": "04 Auth - Register User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const email = `student-${Date.now()}@example.com`;",
              "pm.collectionVariables.set('userEmail', email);",
              "pm.collectionVariables.set('userPassword', 'password123');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registered', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.token);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "05 Auth - Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logged in as USER', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.token);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "06 Auth - Current User",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "07 Auth - Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Token refreshed', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.token);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "08 Contacts - Create Public Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Public request created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('contactId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Public Client\",\n  \"email\": \"client@example.com\",\n  \"message\": \"Need a website and backend for my project\"\n}"
        },
        "url": "{{baseUrl}}/contacts"
      }
    },
    {
      "name": "09 Contacts - Create User Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User request created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('contactId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"{{userEmail}}\",\n  \"message\": \"This request is linked to the registered user\"\n}"
        },
        "url": "{{baseUrl}}/contacts"
      }
    },
    {
      "name": "10 Contacts - My Requests",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/contacts/my"
      }
    },
    {
      "name": "11 Admin - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logged in as ADMIN', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "12 Admin - All Requests",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/contacts"
      }
    },
    {
      "name": "13 Admin - One Request",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/contacts/{{contactId}}"
      }
    },
    {
      "name": "14 Admin - Update Status",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": "{{baseUrl}}/contacts/{{contactId}}/status"
      }
    },
    {
      "name": "15 Admin - Update Priority And Comment",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\",\n  \"comment\": \"Client was contacted. Need to prepare estimate.\"\n}"
        },
        "url": "{{baseUrl}}/contacts/{{contactId}}"
      }
    },
    {
      "name": "16 Security - User Cannot Open Admin Requests",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/contacts"
      }
    },
    {
      "name": "17 Admin - Delete Request",
      "request": {
        "method": "DELETE",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/contacts/{{contactId}}"
      }
    },
    {
      "name": "18 Auth - Logout User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/logout"
      }
    }
  ]
}
